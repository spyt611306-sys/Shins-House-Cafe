# Shin's House production settings (Netlify Environment Variables)
SITE_URL=https://shinshouse.netlify.app
COMMERCE_ENABLED=true
LEGAL_APPROVED=false
BUSINESS_NAME=신스하우스
REPRESENTATIVE_NAME=
BUSINESS_NUMBER=
MAIL_ORDER_NUMBER=
BUSINESS_ADDRESS=부산광역시 부산진구 새싹로8번길 35-8 1층
PRIVACY_OFFICER=
CUSTOMER_PHONE=0503-5260-7479
CUSTOMER_EMAIL=
RETURN_ADDRESS=부산광역시 부산진구 새싹로8번길 35-8 1층 신스하우스

# Shipping / bank transfer
SHIPPING_FEE=3000
FREE_SHIPPING_THRESHOLD=50000
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
TRANSFER_NOTICE=주문은 정상 접수되었습니다. 입금 계좌가 화면에 표시되지 않는 경우 신스하우스에서 별도로 안내드립니다.
SHIPPING_NOTICE=입금 확인 후 로스팅·포장·검수하여 순차 발송합니다.

# Administrator access (server-side only)
ADMIN_EMAIL=admin@shinshouse.local
ADMIN_PASSWORD=
# Optional. If omitted, signing is derived server-side from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
ACTION_TOKEN_SECRET=

# Commerce data and uploaded media are stored in production Netlify Blobs.
